# Copie este arquivo para ".env" e preencha os valores.

# --- Conexão com o painel (worker.py) ---
# URL do dashboard e Token Mestre da fila: aba "API & Integração" da fila
# "vivosmartcobertura" no painel.
API_BASE_URL=http://192.168.100.2/workers
QUEUE_SLUG=vivosmartcobertura
QUEUE_TOKEN=
WORKER_NAME=Worker-Cobertura-01

# --- Login / Navegador (src/auth/login_captcha.py, src/core/browser_manager.py) ---
LOGIN_URL=https://simplifiquevivoemp.com.br
LOGIN_REDIRECT_URL=https://vivovendas.vivo.com.br/sales_ext/start.swe?SWECmd=GotoView&SWEView=NV+Dealer+Home+Page+View&SWERF=1&SWEHo=vivovendas.vivo.com.br&SWEBU=1

# --- Credenciais ---
# Em produção o worker.py NÃO lê estas chaves: vivo_user, vivo_senha,
# email_user e email_senha são cadastradas no painel, na tela de edição DESTE
# worker (aparecem sozinhas depois do primeiro poll). Aqui elas só servem aos
# testes manuais (test_login.py / test_coverage.py), que rodam sem o painel.
vivo_user=
vivo_senha=
email_user=
email_senha=

# Versão do Chrome instalada na máquina (opcional; detectada automaticamente se vazio)
CHROME_VERSION=
